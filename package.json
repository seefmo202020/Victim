{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next build --webpack && next start --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:bonto": "drizzle-kit push --force --config=drizzle.config.bonto.ts && STANDALONE_OUTPUT=1 next build && node scripts/prepare-standalone.mjs",
    "start:bonto": "node .next/standalone/server.js",
    "db:push": "drizzle-kit push --force --config=drizzle.config.bonto.ts"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
